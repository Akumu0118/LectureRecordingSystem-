# Template only: settings load backend/.env, not this file.
# Replace the placeholder password. URL-encode reserved characters in passwords.
DATABASE_URL=postgresql+psycopg://voiceclean:CHANGE_ME@localhost:5432/voiceclean
# JSON array; keep development origins explicit.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reference uploads only. Relative storage paths resolve from backend/.
STORAGE_ROOT=storage
MAX_REFERENCE_SIZE_BYTES=10485760
MAX_REFERENCE_DURATION_SECONDS=120
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# Original lecture uploads: 512 MiB, 4 hours, 180-second validation timeout.
MAX_RECORDING_SIZE_BYTES=536870912
MAX_RECORDING_DURATION_SECONDS=14400
RECORDING_PROBE_TIMEOUT_SECONDS=180

# Phase 5: local FFmpeg jobs (one Uvicorn worker)
FFMPEG_PATH=ffmpeg
AUDIO_JOB_TIMEOUT_SECONDS=600
MAX_AUDIO_JOBS=2
MAX_GENERATED_SIZE_BYTES=536870912
